outputs/

# The polling workbook. Ignored by default for two reasons: it is a working
# data file that gets re-saved every week, so committing it puts an ~850KB
# binary diff in history each time, and it is yours rather than the code's.
# If you want the repository to be self-contained, so the pipeline runs in
# Colab or a fresh container without the OneDrive path, delete these two lines
# and commit the file. Consider Git LFS if you do.
data_store/manual/MidtermPolls2026.xlsx
data_store/manual/*.xlsx
data_store/manual/new_polls_*.csv
